# vLLM sunucu ayarları
VLLM_URL=http://localhost:8001/v1/chat/completions
VLLM_MODEL=qwen3-vl-30b-a3b

# OCR güven eşiği (0.0 - 1.0)
OCR_CONFIDENCE_THRESHOLD=0.5

# RAG: embedding modeli sohbet modelinden ayrıdır
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docquery_documents
EMBEDDING_URL=http://localhost:8002/v1/embeddings
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
VLLM_API_KEY=
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=200
RAG_SCORE_THRESHOLD=0.35

# Web arayüzü CLI indeksinden ayrı tutulur
WEB_QDRANT_COLLECTION=docquery_web_documents
